+package com.example.shop.product.adapter.`in`.web
+
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PathVariable
+import org.springframework.web.bind.annotation.RestController
+
+@RestController
+class ProductController(private val productService: ProductService) {
+
+    @GetMapping("/api/products/{id}")
+    fun getProduct(@PathVariable id: Long): ProductResponse {
+        val product = productService.findById(id)
+        return ProductResponse(
+            id = product.id.toString(),
+            name = product.name,
+            price = product.price.toPlainString(),
+        )
+    }
+
+    @GetMapping("/api/products")
+    fun listProducts(): List<ProductResponse> {
+        return productService.findAll().map { product ->
+            ProductResponse(
+                id = product.id.toString(),
+                name = product.name,
+                price = product.price.toPlainString(),
+            )
+        }
+    }
+}
+
+data class ProductResponse(val id: String, val name: String, val price: String)
