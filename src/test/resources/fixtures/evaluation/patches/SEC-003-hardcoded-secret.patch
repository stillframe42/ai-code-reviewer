+package com.example.shop.notification.adapter.out
+
+import org.springframework.stereotype.Component
+import org.springframework.web.client.RestClient
+
+@Component
+class OAuthTokenProvider(private val restClient: RestClient) {
+
+    private val slackWebhookUrl = "https://hooks.slack.com/services/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"
+    private val apiKey = "sk-proj-abc123def456ghi789jkl012mno345pqr678stu901vwx234"
+    private val clientSecret = "cs_live_a1B2c3D4e5F6g7H8i9J0kLmNoPqRsTuVwXyZ"
+
+    fun sendSlackNotification(channel: String, message: String) {
+        restClient.post()
+            .uri(slackWebhookUrl)
+            .body(mapOf("channel" to channel, "text" to message))
+            .retrieve()
+            .toBodilessEntity()
+    }
+
+    fun fetchExternalData(endpoint: String): String {
+        return restClient.get()
+            .uri(endpoint)
+            .header("Authorization", "Bearer $apiKey")
+            .header("X-Client-Secret", clientSecret)
+            .retrieve()
+            .body(String::class.java) ?: ""
+    }
+
+    fun refreshToken(): String {
+        val credentials = "app-id:$clientSecret"
+        return "refreshed-token-${credentials.hashCode()}"
+    }
+}
