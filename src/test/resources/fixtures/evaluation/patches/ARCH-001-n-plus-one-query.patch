+package com.example.shop.order.adapter.out.persistence
+
+import org.springframework.stereotype.Repository
+
+@Repository
+class OrderRepository(
+    private val orderJpaRepository: OrderJpaRepository,
+    private val orderItemJpaRepository: OrderItemJpaRepository,
+) {
+    fun findAllWithItems(): List<OrderWithItems> {
+        val orders = orderJpaRepository.findAll()
+        return orders.map { order ->
+            val items = orderItemJpaRepository.findByOrderId(order.id)
+            OrderWithItems(
+                orderId = order.id,
+                customerName = order.customerName,
+                items = items.map { item ->
+                    val product = orderItemJpaRepository.findProductById(item.productId)
+                    OrderItemDetail(
+                        productName = product?.name ?: "unknown",
+                        quantity = item.quantity,
+                        price = item.price,
+                    )
+                },
+            )
+        }
+    }
+
+    fun findOrderSummaries(customerId: Long): List<OrderSummary> {
+        val orders = orderJpaRepository.findByCustomerId(customerId)
+        return orders.map { order ->
+            val itemCount = orderItemJpaRepository.countByOrderId(order.id)
+            OrderSummary(orderId = order.id, itemCount = itemCount, total = order.totalAmount)
+        }
+    }
+}
