+package com.example.shop.order.domain
+
+import jakarta.validation.constraints.*
+import java.math.BigDecimal
+import java.time.*
+
+class OrderValidator {
+
+    fun validate(request: OrderCreateRequest): List<String> {
+        val errors = mutableListOf<String>()
+
+        if (request.customerName.isBlank()) {
+            errors.add("고객명은 필수입니다")
+        }
+        if (request.items.isEmpty()) {
+            errors.add("주문 항목이 비어있습니다")
+        }
+        if (request.totalAmount <= BigDecimal.ZERO) {
+            errors.add("주문 금액은 양수여야 합니다")
+        }
+        if (request.deliveryDate.isBefore(LocalDate.now())) {
+            errors.add("배송일은 오늘 이후여야 합니다")
+        }
+        return errors
+    }
+}
+
+data class OrderCreateRequest(
+    val customerName: String,
+    val items: List<String>,
+    val totalAmount: BigDecimal,
+    val deliveryDate: LocalDate,
+    val note: String? = null,
+)
