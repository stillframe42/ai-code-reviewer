+package com.example.shop.user.adapter.`in`.web
+
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PathVariable
+import org.springframework.web.bind.annotation.RestController
+import java.time.Instant
+
+@RestController
+class UserController(private val userRepository: UserRepository) {
+
+    @GetMapping("/api/users/{id}")
+    fun getUser(@PathVariable id: Long): UserEntity {
+        return userRepository.findById(id)
+            ?: throw NoSuchElementException("사용자를 찾을 수 없습니다: $id")
+    }
+
+    @GetMapping("/api/users")
+    fun listUsers(): List<UserEntity> {
+        return userRepository.findAll()
+    }
+}
+
+data class UserEntity(
+    val id: Long,
+    val username: String,
+    val email: String,
+    val passwordHash: String,
+    val salt: String,
+    val loginFailCount: Int,
+    val lastLoginIp: String?,
+    val internalMemo: String?,
+    val roleFlags: Int,
+    val createdAt: Instant,
+    val updatedAt: Instant,
+    val deletedAt: Instant?,
+    val adminNotes: String? = null,
+)
