# Langfuse 인증 시크릿 — 실제 값은 .env 파일에 설정 (절대 커밋 금지)
# 생성 방법: openssl rand -hex 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# Langfuse 비밀번호 해싱용 Salt
# 생성 방법: openssl rand -hex 16
SALT=your-salt-here

# Grafana 어드민 패스워드 (기본값: admin, 운영 환경에서는 반드시 변경)
GF_SECURITY_ADMIN_PASSWORD=your-grafana-admin-password

# === 분산 추적 (Grafana Tempo) ===
# 분산 추적 사용 시 docker-compose.monitoring.yml (Tempo) 을 먼저 기동해야 한다.

# ai-agent-service(Python 컨테이너) OTLP collector 엔드포인트. 미설정 시 추적 비활성.
# Grafana Tempo 사용 시 예: http://host.docker.internal:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# ai-code-reviewer(Spring Boot) span export 활성 여부. 기본 활성 — collector 없이 실행 시 false 로 비활성화.
#OTEL_TRACING_EXPORT_ENABLED=false
# ai-code-reviewer OTLP/HTTP 엔드포인트. 미설정 시 기본값(http://localhost:4318/v1/traces) 사용.
#OTEL_TRACING_ENDPOINT=http://localhost:4318/v1/traces
